# Where the dev server forwards /v1 requests (the ShopCore API).
VITE_API_PROXY=http://localhost:8080
# In production, serve the admin and the API from one address (a reverse proxy) so the refresh cookie works.
# Only set this if the API is on another address and you have set CORS_ORIGINS on the server.
# VITE_API_URL=https://api.example.com
